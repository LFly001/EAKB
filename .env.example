# ============================================================
# EAKB 企业知识库智能助手 — 环境变量模板
# 使用说明: 复制为 .env 并修改实际值，禁止提交 .env 到代码仓库
# ============================================================

# ============================
# 1. 数据库 — MySQL 8.0
# ============================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=eakb
MYSQL_PASSWORD=eakb123456
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=eakb
# SQLAlchemy 连接池配置
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE=3600
DB_ECHO=false

# ============================
# 2. 向量库 — ChromaDB
# ============================
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
# Chroma 持久化存储目录 (本地模式)
CHROMA_PERSIST_DIR=./chroma_data
# 本地 Embedding 模型 (sentence-transformers 加载, 可填 HuggingFace 模型名或本地路径)
EMBEDDING_MODEL_NAME=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=1024

# ============================
# 3. 知识图谱 — Neo4j 5.x
# ============================
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j123456
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50

# ============================
# 4. 对象存储 — MinIO
# ============================
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123456
MINIO_BUCKET=eakb-documents
MINIO_SECURE=false
MINIO_REGION=us-east-1

# ============================
# 5. LLM 大模型配置
# ============================
# 模型名称 (DeepSeek V4 系列: deepseek-v4-pro 高质量 / deepseek-v4-flash 快速低价;
# 旧名 deepseek-chat 已失效)
LLM_MODEL_NAME=deepseek-v4-pro
# API 地址 (支持 OpenAI 兼容接口)
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-api-key-here
# 上下文长度限制
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1
# Embedding 模型 — 文档向量化必需 (Phase 3)
# 默认方案: 本地 bge 模型 (EMBEDDING_MODEL_NAME 见第 2 节),
#           不配置下方的 LLM_EMBEDDING_API_KEY 即走本地模型
# 可选方案: 取消注释并填写任意 OpenAI 兼容 Embedding 接口, 优先走远端
# LLM_EMBEDDING_MODEL=text-embedding-3-large
# LLM_EMBEDDING_API_BASE=https://api.openai.com/v1
# LLM_EMBEDDING_API_KEY=sk-your-api-key-here

# ============================
# 6. JWT 鉴权
# ============================
JWT_SECRET_KEY=change-this-to-a-random-secret-string-at-least-32-chars
JWT_ALGORITHM=HS256
# Access Token 过期时间 (分钟)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh Token 过期时间 (天)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================
# 7. 文件上传
# ============================
# 最大上传大小 (MB)
UPLOAD_MAX_SIZE_MB=50
# 允许的文件后缀 (逗号分隔) — 仅解析器支持的格式
# .doc/.xls 旧格式需先转换为 docx/xlsx
UPLOAD_ALLOWED_EXTENSIONS=pdf,docx,txt,md,xlsx

# ============================
# 8. 服务基础配置
# ============================
# 后端监听
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 前端地址 (CORS 白名单)
FRONTEND_URL=http://localhost:5173
# API 前缀
API_V1_PREFIX=/api/v1

# ============================
# 9. RAG 默认参数 (可被 sys_config 表覆盖)
# ============================
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=64
DEFAULT_TOP_K=5
DEFAULT_SIMILARITY_THRESHOLD=0.7
DEFAULT_MAX_CONTEXT_TOKENS=4096
# 知识图谱增强默认参数 (可被 sys_config 表覆盖)
# DEFAULT_GRAPH_ENHANCE_ENABLED=false
# DEFAULT_GRAPH_ENTITY_TOP_K=5
# DEFAULT_GRAPH_SIMILARITY_THRESHOLD=0.5

# ============================
# 10. 接口限流默认参数 (可被 sys_config 表覆盖, Phase 8)
# ============================
# 默认关闭; 开启后在管理后台「系统配置」页面实时调整阈值
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ============================
# 11. 开发/生产模式
# ============================
# development / production
APP_ENV=development
# 是否输出详细错误堆栈 (生产环境设为 false)
DEBUG=true
